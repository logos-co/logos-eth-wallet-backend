  "main": "eth_wallet_backend_plugin",
  "dependencies": [
    {
      "name": "eth_rpc_module",
      "version": "~0.1.0"
    },
    {
      "name": "fee_module",
      "version": "~0.1.0"
    },
    {
      "name": "keystore_module",
      "version": "~0.1.0"
    },
    {
      "name": "token_list_module",
      "version": "~0.1.0"
    },
    {
      "name": "evm_assets_module",
      "version": "~0.1.0"
    },
    {
      "name": "tx_sender_module",
      "version": "~0.1.0"
    }
  ],
  "include": [],
  "capabilities": [],
  "codegen": {
    "rust": {
      "crate": "rust-lib",
      "trait": "EthWalletBackendModule",
      "source": "src/glue.rs"
    }
  },
  "nix": {
    "external_libraries": [],
    "packages": {
      "build": [],
      "runtime": []
    },
    "cmake": {
      "find_packages": [],
      "extra_include_dirs": []
    }
  }
}
