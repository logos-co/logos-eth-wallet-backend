  "main": "eth_wallet_backend_plugin",
  "dependencies": ["eth_rpc_module", "fee_module", "keystore_module", "token_list_module"],
  "include": [],
  "capabilities": [],
  "codegen": {
    "rust": {
      "crate": "rust-lib",
      "trait": "EthWalletBackendModule",
      "source": "src/glue.rs"
    }
  },
  "nix": {
    "external_libraries": [],
    "packages": { "build": [], "runtime": [] },
    "cmake": { "find_packages": [], "extra_include_dirs": [] }
  }
}
