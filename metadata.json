{
  "name": "eth_wallet_backend",
  "display_name": "Ethereum Wallet Backend",
  "version": "0.1.0",
  "type": "core",
  "interface": "cdylib",
  "concurrency": "multi",
  "category": "wallet",
  "description": "Ethereum-only wallet coordinator: one active network at a time, a fixed token table plus enabled tokens, balances, Send with full fee control \u2014 every transaction leaving through tx_sender_module \u2014 and the local history it keeps.",
  "author": "Logos Core Team",
  "main": "eth_wallet_backend_plugin",
  "dependencies": [
    "eth_rpc_module",
    "fee_module",
    "keystore_module",
    "token_list_module",
    "tx_sender_module"
  ],
  "include": [],
  "capabilities": [],
  "codegen": {
    "rust": {
      "crate": "rust-lib",
      "trait": "EthWalletBackendModule",
      "source": "src/glue.rs"
    }
  },
  "nix": {
    "external_libraries": [],
    "packages": {
      "build": [],
      "runtime": []
    },
    "cmake": {
      "find_packages": [],
      "extra_include_dirs": []
    }
  }
}
